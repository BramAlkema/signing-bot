matrix:
  homeserver: "https://matrix.ctrlaltdef.eu"
  user_id: "@docuseal-bot:matrix.ctrlaltdef.eu"
  access_token: "your_access_token_here"
  # Or use password auth:
  # password: "bot_password"

docuseal:
  url: "https://docuseal.ctrlaltdef.eu"
  api_key: "your_docuseal_api_key"

webhook:
  # URL where this bot receives DocuSeal webhooks
  host: "0.0.0.0"
  port: 8080
  public_url: "https://your-server.com/webhook"
